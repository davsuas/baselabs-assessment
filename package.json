{
  "name": "policy-billing-core",
  "private": true,
  "version": "1.0.0",
  "description": "Base Labs PAS take-home assessment (BLAB-001 Policy Billing & Ledger Core) — npm workspaces root.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "migrate": "ts-node --transpile-only --project tsconfig.json db/migrate.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace packages/backend --if-present && npm run test --workspace packages/frontend --if-present",
    "dev:backend": "npm run dev --workspace packages/backend",
    "dev:frontend": "npm run dev --workspace packages/frontend"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
