        {
          "name": "Get Ledger",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('ledger reports balanced = true', function () {",
                  "    pm.expect(json.balanced).to.eql(true);",
                  "});",
                  "",
                  "pm.test('every transaction has equal debits and credits', function () {",
                  "    const transactions = json.transactions || [];",
                  "    pm.expect(transactions.length).to.be.above(0);",
                  "    transactions.forEach(function (txn) {",
                  "        pm.expect(txn.debits_cents).to.eql(txn.credits_cents);",
                  "    });",
                  "});"
                ]
