{
  "info": {
    "_postman_id": "d4a1c9e0-5b3f-4a2e-9f0a-c9e0d4a1c9e0",
    "name": "BLAB-001 Policy Billing & Ledger Core",
    "description": "Black-box HTTP contract tests for the Policy Administration System take-home (docs/BLAB-001-policy-billing-core/spec.md, contracts/rest-api.md). Run against a local Docker Compose stack with the 'PAS Local' environment, via `docker compose --profile test-integration run --rm newman` (quickstart.md). Seed data matches docs/assessment.md (policy.json / events.json). Every request carries an explicit `X-API-Key: {{apiKey}}` header except the 'Unauthorized' negative case, which deliberately omits it. Deliberately NOT using collection-level auth here: `newman:6-alpine` does not honor a request-level `auth` override (neither `noauth` nor a differing `apikey` value) against a collection-level `apikey` auth block — it always sends the collection-level credential regardless of the request's own auth setting. Verified directly against this image; explicit per-request headers are the portable workaround.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "lastEndorsementId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Endorsements",
      "item": [
        {
          "name": "Apply Endorsement - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 201', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('response includes a billing document with an integer-cents amount', function () {",
                  "    pm.expect(json).to.have.property('billing_document');",
                  "    pm.expect(json.billing_document).to.have.property('amount_cents');",
                  "    pm.expect(Number.isInteger(json.billing_document.amount_cents)).to.be.true;",
                  "});",
                  "",
                  "pm.test('prorated delta matches the documented business rule to the cent', function () {",
                  "    // term_days = 2027-01-01 - 2026-01-01 = 365; remaining_days = 2027-01-01 - 2026-07-01 = 184",
                  "    // delta = round_half_away_from_0((144000 - 120000) * 184 / 365) = round(12098.63...) = 12099",
                  "    pm.expect(json.billing_document.amount_cents).to.eql(12099);",
                  "});",
                  "",
                  "if (json.billing_document && json.billing_document.id) {",
                  "    pm.collectionVariables.set('lastEndorsementId', json.billing_document.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{endorsementIdemKey}}\",\n  \"effective_date\": \"2026-07-01\",\n  \"new_annual_premium_cents\": 144000,\n  \"reason\": \"Water-shutoff discount removed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}/endorsements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "policies", "{{policyId}}", "endorsements"]
            },
            "description": "Sample event from docs/assessment.md events.json (idempotency_key END-2001). Expects one billing document + one policy event created. idempotency_key travels in the body only (contracts/rest-api.md)."
          }
        },
        {
          "name": "Apply Endorsement - Duplicate Delivery (Idempotent Replay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (original result returned, not a new resource)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('returns the same billing document as the original request, no duplicate created', function () {",
                  "    const lastId = pm.collectionVariables.get('lastEndorsementId');",
                  "    if (lastId) {",
                  "        pm.expect(json.billing_document.id).to.eql(lastId);",
                  "    }",
                  "});",
                  "",
                  "pm.test('idempotency result signals a duplicate/replay, not a fresh application', function () {",
                  "    pm.expect(json).to.have.property('idempotency_result');",
                  "    pm.expect(json.idempotency_result).to.eql('duplicate_ignored');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{endorsementIdemKey}}\",\n  \"effective_date\": \"2026-07-01\",\n  \"new_annual_premium_cents\": 144000,\n  \"reason\": \"Water-shutoff discount removed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}/endorsements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "policies", "{{policyId}}", "endorsements"]
            },
            "description": "Same idempotency_key AND same payload as 'Apply Endorsement - Success'. Run this request AFTER that one. Must return the original result with zero new effects (FR-005, SC-002)."
          }
        },
        {
          "name": "Apply Endorsement - Conflicting Payload (Same Key, Different Data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409 (idempotency conflict)', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('error response identifies an idempotency-key conflict', function () {",
                  "    pm.expect(json.error).to.eql('idempotency_conflict');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{endorsementIdemKey}}\",\n  \"effective_date\": \"2026-07-01\",\n  \"new_annual_premium_cents\": 999900,\n  \"reason\": \"Different reason, same key - should be rejected\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}/endorsements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "policies", "{{policyId}}", "endorsements"]
            },
            "description": "Same idempotency_key as the success request but a different new_annual_premium_cents. MUST fail clearly with zero side effects (FR-006)."
          }
        },
        {
          "name": "Apply Endorsement - Effective Date Outside Term (Invalid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422 (business-rule rejection)', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('error identifies the date-out-of-term rule', function () {",
                  "    pm.expect(json.error).to.eql('effective_date_out_of_term');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"END-2099\",\n  \"effective_date\": \"2028-01-01\",\n  \"new_annual_premium_cents\": 150000,\n  \"reason\": \"Effective date is after term_end 2027-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}/endorsements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "policies", "{{policyId}}", "endorsements"]
            },
            "description": "effective_date falls outside [term_start, term_end]. MUST be rejected with no side effects (FR-002, edge case)."
          }
        }
      ]
    },
