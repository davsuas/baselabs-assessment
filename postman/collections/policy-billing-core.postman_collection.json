    {
      "name": "Policy",
      "item": [
        {
          "name": "Get Policy State",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('response includes the required policy-state fields', function () {",
                  "    ['policy_id', 'status', 'annual_premium_cents', 'open_balance_cents', 'history'].forEach(function (field) {",
                  "        pm.expect(json).to.have.property(field);",
                  "    });",
                  "});",
                  "",
                  "pm.test('annual_premium_cents is an integer (never a float)', function () {",
                  "    pm.expect(Number.isInteger(json.annual_premium_cents)).to.be.true;",
                  "});",
                  "",
                  "pm.test('ETag header is present for conditional GET support', function () {",
                  "    pm.response.to.have.header('ETag');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "policies", "{{policyId}}"]
            },
            "description": "Run this after the Endorsements and Payments requests to see cumulative state. Expected shape per contracts/rest-api.md endpoint 3 (FR-016, FR-023)."
