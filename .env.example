# Copy to `.env` at the repo root and fill in real local values. Never commit `.env`
# (constitution Principle V — this file intentionally has no real values).

# --- PostgreSQL admin/migration role -----------------------------------------------------------
# Used by the `db` container's own bootstrap and by the `migrate` service to run
# db/migrate.ts (DDL, functions, views, grants). The running `backend` service never uses this
# role — see APP_DB_PASSWORD below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=policy_billing_core
POSTGRES_PORT=5432

# --- Least-privileged application DB role ------------------------------------------------------
# Created by db/migrations/009_grants.sql (role name `app_user` is fixed in that migration; only
# its password is templated from this env var). This is the role the running backend connects as
# — no UPDATE/DELETE on policy_events/ledger_transactions/ledger_entries (Principle III).
APP_DB_PASSWORD=change-me

# --- API auth (constitution Principle V, FR-024) ------------------------------------------------
# Static API key every /api/* request must send as `X-API-Key`. Any local secret value.
API_KEY=change-me

# --- CORS (Principle V — explicit allow-list, never a wildcard) --------------------------------
CORS_ORIGIN=http://localhost:5173

# --- Rate limiting (Principle V, FR-025, research.md) -------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Ports (host-side mappings; override if these collide with something else locally) ---------
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- Frontend build/dev-server-time config (must be VITE_-prefixed to reach client code) --------
# VITE_API_KEY should match API_KEY above — the frontend is this project's single trusted
# operator's own local client, not a public-facing product (spec.md Assumptions), consistent with
# the "no full authentication system" scope. Documented in the README as a deliberate,
# assessment-scoped simplification, not something to carry into a real product.
#
# VITE_API_BASE_URL is a same-origin relative path by default — the browser calls `/api` on
# whatever origin served the frontend, and packages/frontend/vite.config.ts's dev-server proxy
# forwards it to the real backend (see VITE_DEV_API_PROXY_TARGET below). Leave this as `/api`
# unless the frontend is served from somewhere that can't proxy (out of scope here).
VITE_API_BASE_URL=/api
VITE_API_KEY=change-me

# VITE_DEV_API_PROXY_TARGET: where *the Vite dev server process* (not the browser) should forward
# proxied `/api/*` requests. Unset (default) resolves to http://localhost:3000, correct for
# `npm run dev:frontend` on the host. docker-compose.yml's `frontend` service overrides this to
# `http://backend:3000` (the in-network Compose service name) so the containerized `frontend` and
# `playwright` (test-e2e profile) services resolve the backend correctly too.
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
